// ============================================================================
// cxWythoffUniversal — Universal Wythoffian Coxeter Root-Weight Dual Cone SDFs
// across H_3 (I_h), B_3 (O_h), and A_3 (T_d)
//
// In any 3D Coxeter reflection group W generated by simple roots (unit inward
// mirror normals) a1, a2, a3 with biorthogonal fundamental weights w1, w2, w3
// (dot(wi, aj) = delta_ij), a generator vertex v = d.x*w1 + d.y*w2 + d.z*w3 at
// mirror distances d = (d1, d2, d3) >= 0 generates the Wythoffian polyhedron
// K(d) = conv(W . v). Inside the fundamental Weyl chamber C = {q : dot(ai, q) >= 0},
// the nearest point on K(d) to any chamber point q in C coincides identically
// with the nearest point on the unbounded simplicial cone:
//   K_v = v - R>=0 a1 - R>=0 a2 - R>=0 a3 = {x : dot(oh_i, x - v) <= 0}
// with 3 outward unit face normals oh_i = w_i / ||w_i||, 3 edge rays along -a_i,
// and 1 apex vertex v. Any facet that collapses when d_i -> 0 is automatically
// dominated inside C by the orthogonal weight decomposition.
//
// @author Gemini 4 Argon (sdf-gems, 2026)
// @exact  Yes (||grad d|| = 1, 1-inversesqrt exterior Voronoi cone projection,
//         0-sqrt interior and face Voronoi regions)
// ============================================================================

#ifndef SDF_GEMS_HAS_CX_WYTHOFF_UNIVERSAL
#define SDF_GEMS_HAS_CX_WYTHOFF_UNIVERSAL

// ----------------------------------------------------------------------------
// 1. Universal 3-Root / 3-Weight Simplicial Cone Projector in the Weyl Chamber
//    Returns vec4(signed_distance, unit_gradient_in_chamber).
// ----------------------------------------------------------------------------
vec4 cxProjectRootWeightCone(
    in vec3 q, in vec3 v,
    in vec3 a1, in vec3 a2, in vec3 a3,
    in vec3 oh1, in vec3 oh2, in vec3 oh3 )
{
    vec3 diff = q - v;
    vec3 f = vec3(dot(diff, oh1), dot(diff, oh2), dot(diff, oh3));

    // Dominant facet (exact throughout the interior by Ghost-Facet Suppression)
    float dInt = f.x;
    vec3  gInt = oh1;
    if (f.y > dInt) { dInt = f.y; gInt = oh2; }
    if (f.z > dInt) { dInt = f.z; gInt = oh3; }
    if (dInt <= 0.0) return vec4(dInt, gInt);

    // Exterior 2D face Voronoi prisms (0-sqrt exact projection)
    vec3 x1 = diff - f.x * oh1;
    if (f.x > 0.0 && dot(x1, oh2) <= 0.0 && dot(x1, oh3) <= 0.0) return vec4(f.x, oh1);
    vec3 x2 = diff - f.y * oh2;
    if (f.y > 0.0 && dot(x2, oh1) <= 0.0 && dot(x2, oh3) <= 0.0) return vec4(f.y, oh2);
    vec3 x3 = diff - f.z * oh3;
    if (f.z > 0.0 && dot(x3, oh1) <= 0.0 && dot(x3, oh2) <= 0.0) return vec4(f.z, oh3);

    // Exterior 1D edge rays v - t * a_i (t >= 0) and 0D apex vertex v (1 inversesqrt)
    vec3  bestR  = diff;
    float bestD2 = dot(diff, diff);

    float t1 = max(0.0, -dot(diff, a1));
    vec3  r1 = diff + t1 * a1;
    float d1 = dot(r1, r1);
    if (d1 < bestD2) { bestD2 = d1; bestR = r1; }

    float t2 = max(0.0, -dot(diff, a2));
    vec3  r2 = diff + t2 * a2;
    float d2 = dot(r2, r2);
    if (d2 < bestD2) { bestD2 = d2; bestR = r2; }

    float t3 = max(0.0, -dot(diff, a3));
    vec3  r3 = diff + t3 * a3;
    float d3 = dot(r3, r3);
    if (d3 < bestD2) { bestD2 = d3; bestR = r3; }

    float invD = inversesqrt(max(bestD2, 1e-30));
    vec3  gExt = (bestD2 > 1e-24) ? (bestR * invD) : gInt;
    return vec4(bestD2 * invD, gExt);
}

// Matrix overload taking simple-root columns A, fundamental-weight columns W,
// unit-weight columns OH, and mirror distance vector d = (d1, d2, d3) >= 0.
vec4 cxProjectRootWeightCone(
    in vec3 q, in vec3 d,
    in mat3 A, in mat3 W, in mat3 OH )
{
    vec3 dm = max(d, vec3(0.0));
    vec3 v  = W * dm;
    return cxProjectRootWeightCone(q, v, A[0], A[1], A[2], OH[0], OH[1], OH[2]);
}

// ----------------------------------------------------------------------------
// 2. Icosahedral Coxeter Group H_3 (I_h, order 120)
//    Simple roots: a1 = (0, 1, 0), a2 = (-phi/2, -1/2, 1/(2*phi)), a3 = (1, 0, 0)
//    Fundamental weights: w1 = (0, 1, phi) [5-fold], w2 = (0, 0, 2*phi) [2-fold],
//                         w3 = (1, 0, phi^2) [3-fold]
//    Covers all 7 uniform icosahedral solids & continuous morphs:
//      d = (s, 0, 0) : Icosahedron (12v, 20f)
//      d = (0, s, 0) : Icosidodecahedron (30v, 32f)
//      d = (0, 0, s) : Dodecahedron (20v, 12f)
//      d = (s, s, 0) : Truncated Icosahedron / C60 Buckyball (60v, 32f)
//      d = (0, s, s) : Truncated Dodecahedron (60v, 32f)
//      d = (s, 0, s) : Rhombicosidodecahedron (60v, 62f)
//      d = (s, s, s) : Great Rhombicosidodecahedron / Omnitruncated (120v, 62f)
// ----------------------------------------------------------------------------
vec4 sdgWythoffIcosahedral( in vec3 p, in vec3 d )
{
    const float PHI  = 1.6180339887;
    const float PHI2 = 2.6180339887;
    const vec3  a1   = vec3(0.0, 1.0, 0.0);
    const vec3  a2   = vec3(-0.8090169944, -0.5, 0.3090169944);
    const vec3  a3   = vec3(1.0, 0.0, 0.0);
    const vec3  oh1  = vec3(0.0, 0.5257311121, 0.8506508084);
    const vec3  oh2  = vec3(0.0, 0.0, 1.0);
    const vec3  oh3  = vec3(0.3568220898, 0.0, 0.9341723590);

    vec3 q = p;
    int  m = 0;
    for (int i = 0; i < 5; i++) {
        int bx = (q.x < 0.0) ? 1 : 0;
        int by = (q.y < 0.0) ? 1 : 0;
        q.xy = abs(q.xy);
        float d2 = dot(q, a2);
        int b2 = (d2 < 0.0) ? 1 : 0;
        if (b2 != 0) q -= 2.0 * d2 * a2;
        m |= (bx | (by << 1) | (b2 << 2)) << (3 * i);
    }
    int bx5 = (q.x < 0.0) ? 1 : 0;
    int by5 = (q.y < 0.0) ? 1 : 0;
    q.xy = abs(q.xy);

    vec3 dm = max(d, vec3(0.0));
    vec3 v  = vec3(dm.z, dm.x, PHI * dm.x + (2.0 * PHI) * dm.y + PHI2 * dm.z);
    vec4 res = cxProjectRootWeightCone(q, v, a1, a2, a3, oh1, oh2, oh3);

    vec3 g = res.yzw;
    if (bx5 != 0) g.x = -g.x;
    if (by5 != 0) g.y = -g.y;
    for (int i = 4; i >= 0; i--) {
        int bits = (m >> (3 * i)) & 7;
        if ((bits & 4) != 0) g -= 2.0 * dot(g, a2) * a2;
        if ((bits & 2) != 0) g.y = -g.y;
        if ((bits & 1) != 0) g.x = -g.x;
    }
    return vec4(res.x, g);
}

float sdWythoffIcosahedral( in vec3 p, in vec3 d )
{
    const float PHI  = 1.6180339887;
    const float PHI2 = 2.6180339887;
    const vec3  a1   = vec3(0.0, 1.0, 0.0);
    const vec3  a2   = vec3(-0.8090169944, -0.5, 0.3090169944);
    const vec3  a3   = vec3(1.0, 0.0, 0.0);
    const vec3  oh1  = vec3(0.0, 0.5257311121, 0.8506508084);
    const vec3  oh2  = vec3(0.0, 0.0, 1.0);
    const vec3  oh3  = vec3(0.3568220898, 0.0, 0.9341723590);

    vec3 q = p;
    for (int i = 0; i < 5; i++) {
        q.xy = abs(q.xy);
        q -= 2.0 * min(0.0, dot(q, a2)) * a2;
    }
    q.xy = abs(q.xy);

    vec3 dm = max(d, vec3(0.0));
    vec3 v  = vec3(dm.z, dm.x, PHI * dm.x + (2.0 * PHI) * dm.y + PHI2 * dm.z);
    return cxProjectRootWeightCone(q, v, a1, a2, a3, oh1, oh2, oh3).x;
}

// 60-vertex Truncated Icosahedron (C60 fullerene / soccer ball) of circumradius r.
vec4 sdgBuckyballC60( in vec3 p, in float r )
{
    float s = max(r, 0.0) * 0.2017741062; // 1.0 / ||w1 + w2||
    return sdgWythoffIcosahedral(p, vec3(s, s, 0.0));
}

float sdBuckyballC60( in vec3 p, in float r )
{
    float s = max(r, 0.0) * 0.2017741062;
    return sdWythoffIcosahedral(p, vec3(s, s, 0.0));
}

// ----------------------------------------------------------------------------
// 3. Octahedral Coxeter Group B_3 (O_h, order 48)
//    Chamber C = {q.x >= q.y >= q.z >= 0} via abs + 3-compare sorting network.
//    Simple roots: a1 = (1,-1,0)/sqrt(2), a2 = (0,1,-1)/sqrt(2), a3 = (0,0,1)
//    Fundamental weights: w1 = sqrt(2)*(1,0,0), w2 = sqrt(2)*(1,1,0), w3 = (1,1,1)
//    Covers all 7 uniform octahedral/cubic solids (Octahedron, Cuboctahedron,
//    Cube, Truncated Octahedron, Truncated Cube, Rhombicuboctahedron,
//    Great Rhombicuboctahedron) in 0 loops.
// ----------------------------------------------------------------------------
vec4 sdgWythoffOctahedral( in vec3 p, in vec3 d )
{
    const float S2  = 1.4142135624;
    const float IS2 = 0.7071067812;
    const float IS3 = 0.5773502692;
    const vec3  a1  = vec3(IS2, -IS2, 0.0);
    const vec3  a2  = vec3(0.0, IS2, -IS2);
    const vec3  a3  = vec3(0.0, 0.0, 1.0);
    const vec3  oh1 = vec3(1.0, 0.0, 0.0);
    const vec3  oh2 = vec3(IS2, IS2, 0.0);
    const vec3  oh3 = vec3(IS3, IS3, IS3);

    vec3 sg = vec3((p.x < 0.0) ? -1.0 : 1.0, (p.y < 0.0) ? -1.0 : 1.0, (p.z < 0.0) ? -1.0 : 1.0);
    vec3 q  = abs(p);
    bool s1 = (q.x < q.y); if (s1) q.xy = q.yx;
    bool s2 = (q.y < q.z); if (s2) q.yz = q.zy;
    bool s3 = (q.x < q.y); if (s3) q.xy = q.yx;

    vec3 dm = max(d, vec3(0.0));
    vec3 v  = vec3(S2 * (dm.x + dm.y) + dm.z, S2 * dm.y + dm.z, dm.z);
    vec4 res = cxProjectRootWeightCone(q, v, a1, a2, a3, oh1, oh2, oh3);

    vec3 g = res.yzw;
    if (s3) g.xy = g.yx;
    if (s2) g.yz = g.zy;
    if (s1) g.xy = g.yx;
    return vec4(res.x, sg * g);
}

float sdWythoffOctahedral( in vec3 p, in vec3 d )
{
    return sdgWythoffOctahedral(p, d).x;
}

// ----------------------------------------------------------------------------
// 4. Tetrahedral Coxeter Group A_3 (T_d, order 24)
//    Chamber C = {q.x >= q.y >= |q.z|} via abs + sort + parity sign on q.z.
//    Simple roots: a1 = (0,1,-1)/sqrt(2), a2 = (1,-1,0)/sqrt(2), a3 = (0,1,1)/sqrt(2)
//    Fundamental weights: w1 = (1,1,-1)/sqrt(2), w2 = sqrt(2)*(1,0,0), w3 = (1,1,1)/sqrt(2)
//    Covers all 7 Wythoffian tetrahedral solids (Tetrahedron, Octahedron, Dual
//    Tetrahedron, Truncated Tetrahedron, Cuboctahedron, Truncated Octahedron).
// ----------------------------------------------------------------------------
vec4 sdgWythoffTetrahedral( in vec3 p, in vec3 d )
{
    const float S2  = 1.4142135624;
    const float IS2 = 0.7071067812;
    const float IS3 = 0.5773502692;
    const vec3  a1  = vec3(0.0, IS2, -IS2);
    const vec3  a2  = vec3(IS2, -IS2, 0.0);
    const vec3  a3  = vec3(0.0, IS2, IS2);
    const vec3  oh1 = vec3(IS3, IS3, -IS3);
    const vec3  oh2 = vec3(1.0, 0.0, 0.0);
    const vec3  oh3 = vec3(IS3, IS3, IS3);

    vec3  sg  = vec3((p.x < 0.0) ? -1.0 : 1.0, (p.y < 0.0) ? -1.0 : 1.0, (p.z < 0.0) ? -1.0 : 1.0);
    float par = sg.x * sg.y * sg.z;
    vec3  q   = abs(p);
    bool  s1  = (q.x < q.y); if (s1) q.xy = q.yx;
    bool  s2  = (q.y < q.z); if (s2) q.yz = q.zy;
    bool  s3  = (q.x < q.y); if (s3) q.xy = q.yx;
    q.z *= par;

    vec3 dm = max(d, vec3(0.0));
    vec3 v  = vec3(IS2 * (dm.x + dm.z) + S2 * dm.y, IS2 * (dm.x + dm.z), IS2 * (dm.z - dm.x));
    vec4 res = cxProjectRootWeightCone(q, v, a1, a2, a3, oh1, oh2, oh3);

    vec3 g = res.yzw;
    g.z *= par;
    if (s3) g.xy = g.yx;
    if (s2) g.yz = g.zy;
    if (s1) g.xy = g.yx;
    return vec4(res.x, sg * g);
}

float sdWythoffTetrahedral( in vec3 p, in vec3 d )
{
    return sdgWythoffTetrahedral(p, d).x;
}

#endif // SDF_GEMS_HAS_CX_WYTHOFF_UNIVERSAL
